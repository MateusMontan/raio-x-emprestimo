{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raiox",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raiox-db",
      "database_id": "5832dfed-df38-4666-8082-f7f67f555446",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*"],
  },
  "triggers": {
    "crons": ["17 4 * * *"],
  },
  "ratelimits": [
    {
      "name": "SHARE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
