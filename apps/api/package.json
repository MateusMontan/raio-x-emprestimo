{
  "name": "@raiox/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Raio-X do Empréstimo (Hono no Worker). Por enquanto: camada de aplicação.",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply raiox-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply raiox-db --remote"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.6.3",
    "@raiox/contracts": "workspace:*",
    "@raiox/finance": "workspace:*",
    "@scalar/hono-api-reference": "0.12.20",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261114.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "miniflare": "4.20260730.0",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  }
}
